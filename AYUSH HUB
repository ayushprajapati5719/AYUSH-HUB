-- Helper: Action / Toggle Button
local function addButton(text, callback)
	local btn = Instance.new("TextButton")
	btn.Size = UDim2.new(0.95, 0, 0, 36)
	btn.BackgroundColor3 = Color3.fromRGB(38, 38, 54)
	btn.TextColor3 = Color3.fromRGB(255, 255, 255)
	btn.Text = text
	btn.Font = Enum.Font.GothamSemibold
	btn.TextSize = 13
	btn.Parent = scroll

	local corner = Instance.new("UICorner")
	corner.CornerRadius = UDim.new(0, 8)
	corner.Parent = btn

	btn.MouseButton1Click:Connect(function() callback(btn) end)
	return btn
end

-- Stats Update
local function updateStats()
	local hum = player.Character and player.Character:FindFirstChildOfClass("Humanoid")
	if hum then
		hum.WalkSpeed = currentSpeed
		hum.UseJumpPower = true
		hum.JumpPower = currentJump
	end
end

player.CharacterAdded:Connect(function()
	task.wait(0.2)
	updateStats()
end)

-- 1. Speed & Jump Controls
addAdjustRow("Speed: 16", function(lbl)
	currentSpeed = math.max(16, currentSpeed - 8)
	lbl.Text = "Speed: " .. currentSpeed
	updateStats()
end, function(lbl)
	currentSpeed = math.min(160, currentSpeed + 8)
	lbl.Text = "Speed: " .. currentSpeed
	updateStats()
end)

addAdjustRow("Jump Power: 50", function(lbl)
	currentJump = math.max(50, currentJump - 15)
	lbl.Text = "Jump Power: " .. currentJump
	updateStats()
end, function(lbl)
	currentJump = math.min(250, currentJump + 15)
	lbl.Text = "Jump Power: " .. currentJump
	updateStats()
end)

-- 2. Teleport to Next Island (Workspace.Islands folder se)
addButton("Teleport Next Island", function(btn)
	local islandsFolder = workspace:FindFirstChild("Islands")
	local hrp = player.Character and player.Character:FindFirstChild("HumanoidRootPart")
	if islandsFolder and hrp then
		local islands = islandsFolder:GetChildren()
		if #islands > 0 then
			if islandIndex > #islands then islandIndex = 1 end
			local targetIsland = islands[islandIndex]
			local targetPos = targetIsland:IsA("BasePart") and targetIsland.Position or targetIsland:GetPivot().Position
			hrp.CFrame = CFrame.new(targetPos + Vector3.new(0, 5, 0))
			btn.Text = "TP: " .. targetIsland.Name
			islandIndex += 1
		end
	else
		btn.Text = "No 'Islands' Folder!"
	end
end)

