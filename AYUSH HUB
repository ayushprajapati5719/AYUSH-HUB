-- Helper: Highlight + Tag lagane aur hatane ka function
local function toggleHighlightTag(target, enabled, color, tagName, labelText)
	if not target then return end
	local oldHighlight = target:FindFirstChild(tagName .. "_HL")
	local oldGui = target:FindFirstChild(tagName .. "_Tag")

	if not enabled then
		if oldHighlight then oldHighlight:Destroy() end
		if oldGui then oldGui:Destroy() end
		return
	end

	if not oldHighlight then
		local hl = Instance.new("Highlight")
		hl.Name = tagName .. "_HL"
		hl.FillColor = color
		hl.FillTransparency = 0.5
		hl.OutlineColor = Color3.fromRGB(255, 255, 255)
		hl.Parent = target
	end

	if not oldGui then
		local bill = Instance.new("BillboardGui")
		bill.Name = tagName .. "_Tag"
		bill.Size = UDim2.new(0, 120, 0, 30)
		bill.StudsOffset = Vector3.new(0, 3, 0)
		bill.AlwaysOnTop = true
		bill.Parent = target

		local lbl = Instance.new("TextLabel")
		lbl.Size = UDim2.new(1, 0, 1, 0)
		lbl.BackgroundTransparency = 1
		lbl.Text = labelText
		lbl.TextColor3 = color
		lbl.TextStrokeTransparency = 0
		lbl.Font = Enum.Font.GothamBold
		lbl.TextSize = 13
		lbl.Parent = bill
	end
end

