-- 6. Auto Farm (Workspace.Enemies folder)
addButton("Auto Farm Enemies: OFF", function(btn)
	states.autoFarm = not states.autoFarm
	btn.Text = states.autoFarm and "Auto Farm Enemies: ON" or "Auto Farm Enemies: OFF"
	btn.BackgroundColor3 = states.autoFarm and Color3.fromRGB(95, 55, 180) or Color3.fromRGB(38, 38, 54)

	if states.autoFarm then
		task.spawn(function()
			while states.autoFarm do
				local hrp = player.Character and player.Character:FindFirstChild("HumanoidRootPart")
				local hum = player.Character and player.Character:FindFirstChildOfClass("Humanoid")
				local enemies = workspace:FindFirstChild("Enemies")
				if hrp and hum and enemies then
					for _, enemy in ipairs(enemies:GetChildren()) do
						local eHum = enemy:FindFirstChildOfClass("Humanoid")
						local eRoot = enemy:FindFirstChild("HumanoidRootPart")
						if eHum and eRoot and eHum.Health > 0 then
							hum:MoveTo(eRoot.Position)
							break
						end
					end
				end
				task.wait(0.3)
			end
		end)
	end
end)

-- 7. Factory / Wave Raid Mode (Workspace.RaidBosses folder)
addButton("Auto Factory/Wave Raid: OFF", function(btn)
	states.autoRaid = not states.autoRaid
	btn.Text = states.autoRaid and "Auto Factory/Wave Raid: ON" or "Auto Factory/Wave Raid: OFF"
	btn.BackgroundColor3 = states.autoRaid and Color3.fromRGB(95, 55, 180) or Color3.fromRGB(38, 38, 54)

	if states.autoRaid then
		task.spawn(function()
			while states.autoRaid do
				local hrp = player.Character and player.Character:FindFirstChild("HumanoidRootPart")
				local raidFolder = workspace:FindFirstChild("RaidBosses")
				if hrp and raidFolder then
					local boss = raidFolder:GetChildren()[1]
					local bRoot = boss and (boss:FindFirstChild("HumanoidRootPart") or boss:IsA("BasePart") and boss)
					if bRoot then
						hrp.CFrame = CFrame.new(bRoot.Position + Vector3.new(0, 4, 6))
					end
				end
				task.wait(0.5)
			end
		end)
	end
end)

